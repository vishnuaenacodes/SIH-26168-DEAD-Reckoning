<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1D1D1F">

    <!-- Top Product Navigation Bar -->
    <LinearLayout
        android:id="@+id/globalHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#1D1D1F"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DR NAV"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"/>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="#3A3A3C"
            android:layout_marginHorizontal="12dp"/>

        <!-- System Status Badge -->
        <LinearLayout
            android:id="@+id/badgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="#272729"
            android:paddingHorizontal="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:id="@+id/dotStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#2997FF"/>
            <TextView
                android:id="@+id/tvHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS ONLINE"
                android:textColor="#2997FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Action Icons -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#A1A1A6"
            android:layout_marginEnd="16dp"/>
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="#0071E3"/>
    </LinearLayout>

    <!-- Sub-Navigation Bar (Horizontal Tabs) -->
    <HorizontalScrollView
        android:id="@+id/subNavBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#272729"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/globalHeader">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/tabDashboard"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="#0066CC"
                android:paddingHorizontal="14dp"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/tabNav"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Navigation"
                android:textColor="#A1A1A6"
                android:textSize="12sp"
                android:background="@null"
                android:paddingHorizontal="14dp"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/tabSensors"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Sensors"
                android:textColor="#A1A1A6"
                android:textSize="12sp"
                android:background="@null"
                android:paddingHorizontal="14dp"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/tabEKF"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="EKF Fusion"
                android:textColor="#A1A1A6"
                android:textSize="12sp"
                android:background="@null"
                android:paddingHorizontal="14dp"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/tabML"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="ML TCN"
                android:textColor="#A1A1A6"
                android:textSize="12sp"
                android:background="@null"
                android:paddingHorizontal="14dp"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/tabComparison"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Comparison"
                android:textColor="#A1A1A6"
                android:textSize="12sp"
                android:background="@null"
                android:paddingHorizontal="14dp"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/tabJuryDemo"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="⚡ SIH Jury Demo"
                android:textColor="#2997FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@null"
                android:paddingHorizontal="14dp"
                android:textAllCaps="false"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Content Frame Container -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/subNavBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. DASHBOARD VIEW -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/viewDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Top Route Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/topCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="14dp"
                app:cardBackgroundColor="#1D1D1F"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:strokeColor="#2A2A2C"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <AutoCompleteTextView
                        android:id="@+id/inputFrom"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="#272729"
                        android:hint="Current Location (GNSS)"
                        android:textColorHint="#7A7A7A"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="14dp"
                        android:textSize="13sp"
                        android:completionThreshold="2"
                        android:inputType="textPostalAddress"/>

                    <AutoCompleteTextView
                        android:id="@+id/inputTo"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="#272729"
                        android:hint="Enter Destination..."
                        android:textColorHint="#7A7A7A"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="14dp"
                        android:textSize="13sp"
                        android:completionThreshold="2"
                        android:inputType="textPostalAddress"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetRoute"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:text="Get Directions"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        app:cornerRadius="9999dp"
                        app:backgroundTint="#0066CC"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Floating Telemetry Overlay Pill -->
            <LinearLayout
                android:id="@+id/telemetryOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1D1D1F"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:orientation="horizontal"
                android:layout_margin="14dp"
                app:layout_constraintTop_toBottomOf="@id/topCard"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPEED"
                        android:textColor="#7A7A7A"
                        android:textSize="9sp"/>
                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="42 km/h"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#3A3A3C" android:layout_marginHorizontal="12dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DRIFT ERROR"
                        android:textColor="#7A7A7A"
                        android:textSize="9sp"/>
                    <TextView
                        android:id="@+id/tvDrift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="±0.4 m"
                        android:textColor="#2997FF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#3A3A3C" android:layout_marginHorizontal="12dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONFIDENCE"
                        android:textColor="#7A7A7A"
                        android:textSize="9sp"/>
                    <TextView
                        android:id="@+id/tvConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="98%"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Recenter FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnRecenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:src="@android:drawable/ic_menu_mylocation"
                app:backgroundTint="#272729"
                app:tint="#0071E3"
                app:layout_constraintBottom_toTopOf="@id/bottomPanel"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Bottom Navigation Bar Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bottomPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="14dp"
                app:cardBackgroundColor="#1D1D1F"
                app:cardCornerRadius="18dp"
                app:strokeColor="#2A2A2C"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0 km"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp"
                            android:textStyle="bold"/>
                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GPS Available"
                            android:textColor="#2997FF"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartNavigation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="Start Navigation"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:cornerRadius="9999dp"
                        app:backgroundTint="#0066CC"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. SENSORS VIEW -->
        <ScrollView
            android:id="@+id/viewSensors"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1D1D1F"
            android:padding="16dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMU SENSOR MATRIX"
                    android:textColor="#2997FF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real-time 100 Hz Telemetry &amp; Health"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <!-- Accelerometer Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#272729"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accelerometer (3-Axis)" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
                        <TextView android:id="@+id/tvAccelValues" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X: +0.02 m/s² | Y: +0.15 m/s² | Z: +9.81 m/s²" android:textColor="#A1A1A6" android:textSize="13sp" android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Gyroscope Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#272729"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gyroscope (Angular Rate)" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
                        <TextView android:id="@+id/tvGyroValues" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ωx: 0.00 rad/s | ωy: 0.01 rad/s | ωz: 0.02 rad/s" android:textColor="#A1A1A6" android:textSize="13sp" android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sensor Health Summary -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#272729"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sensor Sampling &amp; Noise" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
                        <TextView android:id="@+id/tvSensorStats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sampling Rate: 100 Hz | Health: 98% | Noise: Low" android:textColor="#2997FF" android:textSize="13sp" android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- 3. EKF FUSION VIEW -->
        <ScrollView
            android:id="@+id/viewEKF"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1D1D1F"
            android:padding="16dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SENSOR FUSION"
                    android:textColor="#2997FF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extended Kalman Filter (EKF)"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#272729"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EKF Pipeline Status" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Inputs: IMU (Accel + Gyro) + TCN Model Velocity\n• Prediction: High-rate Kinematic Propagation\n• Correction: Error-State Covariance Bounding\n• Fused Output: Position, Speed, Heading" android:textColor="#A1A1A6" android:textSize="13sp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- 4. ML TCN VIEW -->
        <ScrollView
            android:id="@+id/viewML"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1D1D1F"
            android:padding="16dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI TRAJECTORY PREDICTION"
                    android:textColor="#2997FF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temporal Convolutional Network"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#272729"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ONNX Runtime Model Spec" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Model File: velocity_model.onnx\n• Input Shape: [1, 50, 9] (50-step IMU window)\n• Inference Engine: ONNX Runtime Edge\n• Model State: ACTIVE &amp; LOADED" android:textColor="#A1A1A6" android:textSize="13sp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- 5. COMPARISON VIEW -->
        <ScrollView
            android:id="@+id/viewComparison"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1D1D1F"
            android:padding="16dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRAJECTORY RECONCILIATION"
                    android:textColor="#2997FF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS vs Dead-Reckoning Comparison"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#272729"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trajectory Comparison Metrics" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
                        <TextView android:id="@+id/tvComparisonStats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• GPS Ground Truth: Active\n• EKF Fused Path: Synced\n• TCN Predicted Path: Aligned\n• Mean Position Error: ±0.34 meters" android:textColor="#A1A1A6" android:textSize="13sp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- 6. SIH JURY DEMO VIEW -->
        <ScrollView
            android:id="@+id/viewJuryDemo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1D1D1F"
            android:padding="16dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIH DEMONSTRATION MODE"
                    android:textColor="#2997FF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS Blackout &amp; Recovery Simulation"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <!-- Simulation Control Buttons Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#272729"
                    app:cardCornerRadius="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Interactive Jury Controls"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimulateGpsLoss"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="12dp"
                            android:text="⚡ SIMULATE GPS LOSS (Start Dead Reckoning)"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            app:cornerRadius="9999dp"
                            app:backgroundTint="#FF3D00"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRecoverGps"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="10dp"
                            android:text="✅ RECOVER GPS SIGNAL (Reconcile Trajectory)"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            app:cornerRadius="9999dp"
                            app:backgroundTint="#0066CC"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetSim"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:text="Reset Simulation"
                            android:textAllCaps="false"
                            android:textColor="#A1A1A6"
                            android:textSize="13sp"
                            app:cornerRadius="9999dp"
                            app:backgroundTint="#2A2A2C"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Live Simulation Pipeline Flow Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#272729"
                    app:cardCornerRadius="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live Pipeline Execution Log"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvDemoLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="[00:00] System Ready. GNSS Signal Active.\nPress 'SIMULATE GPS LOSS' to start demonstration."
                            android:textColor="#2997FF"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="10dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
